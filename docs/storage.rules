rules_version = '2';

// Regras do Cloud Storage do projeto `cinerea1`.
//
// Publicar: `npx firebase-tools deploy --only storage`.
//
// SEM CONSULTA ENTRE SERVIÇOS, e isso é deliberado.
//
// A primeira versão perguntava ao Firestore se quem envia está em `gestores`.
// É mais preciso, e não funcionou: essa ponte exige uma permissão IAM que a
// documentação diz ser pedida "ao salvar as regras pela primeira vez" — e que
// nunca chegou a ser concedida. O sintoma foi `storage/unauthorized` sem pista
// nenhuma, e o emulador não reproduz porque não exige a permissão.
//
// O preço de abrir mão dela: qualquer conta autenticada pode enviar imagem
// dentro da PRÓPRIA pasta. Não pode sobrescrever a de ninguém, não pode passar
// de 2 MB e não pode enviar o que não for imagem. O App Check fecha o resto,
// garantindo que a requisição venha mesmo dos nossos apps.

service firebase.storage {
  match /b/{bucket}/o {

    // Foto de produto. O `dono` no caminho é o uid de quem enviou: cada um
    // escreve só na própria pasta, e um cliente não alcança a foto da loja.
    match /produtos/{dono}/{arquivo} {
      // Leitura aberta: é vitrine. O app e o site mostram sem login.
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == dono
        // Sem teto, um envio errado de vídeo ou de foto crua de 40 MB vira
        // conta no fim do mês — o plano Blaze não tem limite rígido.
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == dono;
    }

    // Logo que o dono da peça põe na página dela. Mesma forma da pasta acima:
    // o uid no caminho, cada um escreve só no que é seu.
    //
    // O TETO É MENOR, e de propósito. Foto de produto é conteúdo da loja e sai
    // uma vez por peça; logo é servido a CADA convidado que encosta o celular,
    // e um arquivo gordo aqui vira banda paga mil vezes. 512 KB já é generoso
    // para uma marca, e o painel ainda encolhe antes de enviar.
    match /logos/{dono}/{arquivo} {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == dono
        && request.resource.size < 512 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == dono;
    }

    // Arte do banner da loja. Uma imagem só, larga, no alto da vitrine.
    //
    // Teto entre os outros dois de propósito: é servida a todo visitante da
    // loja, como o logo, mas é uma imagem larga e não um símbolo — 400 KB
    // acomoda 1600px de largura em WebP com folga, e o painel encolhe antes.
    match /banners/{dono}/{arquivo} {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == dono
        && request.resource.size < 400 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == dono;
    }

    // Nada mais é gravável. Uma pasta esquecida aberta é onde nascem as
    // surpresas de fatura.
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
