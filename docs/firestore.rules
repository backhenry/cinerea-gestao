rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ATENÇÃO: as regras do Firestore são UM arquivo só para o projeto inteiro
    // (`cinerea1`). Este arquivo é o conjunto completo: o sistema de gestão
    // (usuarios/, empresas/, catalogo/, portal/, rfq/, convites/) MAIS o app dos
    // clientes (clientes/). Publicar só a parte de baixo apagaria a de cima.
    //
    // Este arquivo existe idêntico em dois repositórios:
    //   cinerea-app    → docs/firestore.rules   (é daqui que se publica)
    //   cinerea-gestao → docs/firestore.rules   (espelho, alimenta o CI de lá)
    // Mudou em um, copie no outro — senão os testes de um lado passam a
    // proteger uma regra que não é a que está no ar.

    // ---------- funções de papel ----------
    function ehMembro(eid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/empresas/$(eid)/membros/$(request.auth.uid));
    }
    function ehDono(eid) {
      return request.auth != null
        && get(/databases/$(database)/documents/empresas/$(eid)).data.dono == request.auth.uid;
    }
    function ehGestor(eid) {
      // dono ou admin
      return ehDono(eid) || (ehMembro(eid)
        && get(/databases/$(database)/documents/empresas/$(eid)/membros/$(request.auth.uid)).data.get('papel','') == 'admin');
    }
    function ehFin(eid) {
      // dono, admin ou sócio — quem enxerga o financeiro
      return ehDono(eid) || (ehMembro(eid)
        && get(/databases/$(database)/documents/empresas/$(eid)/membros/$(request.auth.uid)).data.get('papel','') in ['admin','socio']);
    }
    function ehDaCasa() {
      // Quem pode abrir empresa no sistema de gestão. Antes disto, QUALQUER conta
      // autenticada podia — inclusive um cliente do app, que usa o mesmo Auth.
      return request.auth != null
        && exists(/databases/$(database)/documents/gestores/$(request.auth.uid));
    }

    // Lista de quem é da casa. Um documento vazio por uid basta — o que importa
    // é existir. Só se mexe pelo Console do Firebase: nenhum app escreve aqui.
    //
    // Cada um lê APENAS o próprio documento, e só para saber se é da casa — é
    // isso que faz o app dos clientes mostrar a opção de registrar peça na
    // produção para o dono, e escondê-la de todo mundo. Ler o dos outros
    // continua negado, então ninguém descobre quem mais é gestor.
    match /gestores/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Registro de fábrica: uma peça Cinérea que existe no mundo.
    // O id é o UID do chip — o mesmo que identifica a peça no app do cliente.
    //
    // Leitura aberta de propósito: é a certidão da peça, e no futuro a página
    // que o convidado abre ao encostar precisa lê-la sem login. Não há nada
    // pessoal aqui — modelo, número de série e data de fabricação.
    // Escrita só de quem é da casa: é isto que impede um cliente de forjar
    // procedência para uma peça que a Cinérea não fez.
    // LEITURA POR ID, NUNCA POR LISTA.
    //
    // `read` cobre `get` e `list` juntos, e com `list` liberado qualquer pessoa
    // sem login enumera TODOS os tagUid já registrados. Isso quebra a premissa
    // do sistema inteiro: a de que conhecer o UID de um chip significa ter
    // encostado na peça. Com a lista aberta, formava-se uma corrente —
    // enumerar as peças, criar uma conta comum, registrá-las na conta própria
    // (a regra permite qualquer id na subcoleção do cliente) e assim ganhar
    // permissão de reescrever a vitrine pública de cada peça vendida.
    //
    // Nada no projeto lista estas coleções: app, site e gestão buscam por id.
    match /pecas/{tagUid} {
      allow get: if true;
      allow list: if false;
      allow create, update: if ehDaCasa();
      allow delete: if false;
    }

    // Conta individual: ponteiro para a empresa + preferências + dados legados
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Empresa: dados compartilhados
    match /empresas/{eid} {
      allow create: if ehDaCasa() && request.resource.data.dono == request.auth.uid;
      allow read: if ehMembro(eid);
      // qualquer membro salva os DADOS; nome só gestor; o dono nunca muda
      allow update: if ehMembro(eid)
        && request.resource.data.dono == resource.data.dono
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dados','atualizado'])
            || ehGestor(eid));
      allow delete: if ehDono(eid);

      // Membros: papel definido pelo convite; só gestor muda papéis
      match /membros/{mUid} {
        allow read: if ehMembro(eid);
        allow create: if request.auth != null && request.auth.uid == mUid && (
          ehDono(eid)
          || (request.resource.data.codigo is string
              && get(/databases/$(database)/documents/convites/$(request.resource.data.codigo)).data.empresaId == eid
              && request.resource.data.get('papel','empregado')
                 == get(/databases/$(database)/documents/convites/$(request.resource.data.codigo)).data.get('papel','empregado'))
          // Entrar por AUTORIZAÇÃO DE E-MAIL.
          //
          // `email_verified` é exigido, e não é excesso de zelo: o Firebase não
          // confere o e-mail no cadastro por senha. Sem esta linha, quem
          // descobrisse que fulano@empresa.com foi convidado criava uma conta
          // com esse endereço e entrava no lugar dele — num sistema que mostra
          // faturamento, margem e a base de clientes.
          || (request.auth.token.email_verified == true
              && exists(/databases/$(database)/documents/acessos/$(request.auth.token.email.lower()))
              && get(/databases/$(database)/documents/acessos/$(request.auth.token.email.lower())).data.empresaId == eid
              && request.resource.data.get('papel','empregado')
                 == get(/databases/$(database)/documents/acessos/$(request.auth.token.email.lower())).data.get('papel','empregado'))
        );
        // cada um só edita o próprio NOME; papel é com o gestor
        allow update: if request.auth != null && (
          (request.auth.uid == mUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome']))
          || ehGestor(eid)
        );
        // sair (não sendo dono) ou gestor remove (menos o dono)
        allow delete: if request.auth != null
          && mUid != get(/databases/$(database)/documents/empresas/$(eid)).data.dono
          && (request.auth.uid == mUid || ehGestor(eid));
      }

      // Financeiro: NEGADO no servidor para empregados
      match /fin/{fdoc} {
        allow read, write: if ehFin(eid);
      }

      // Backups mensais automáticos (contêm o financeiro)
      match /backups/{b} {
        allow read, write: if ehFin(eid);
      }

      // Arquivo de anos anteriores (registros operacionais)
      match /arquivo/{ano} {
        allow read, write: if ehMembro(eid);
      }

      // Diagnóstico: erros de execução capturados pelo app
      match /diag/{d} {
        allow read, write: if ehMembro(eid);
      }
    }

    // Acesso por E-MAIL. O id do documento é o e-mail em minúsculas.
    //
    // POR QUE ISTO EXISTE, e por que não é "cadastrar o usuário": criar conta de
    // outra pessoa exige o Admin SDK num servidor, que este projeto não tem —
    // e fazer isso pelo navegador desconectaria quem está cadastrando da própria
    // sessão. Então o que se cadastra é a AUTORIZAÇÃO: a casa diz que aquele
    // e-mail pode entrar e com que papel, e a pessoa cria a própria senha.
    //
    // Melhor que o código de convite em duas coisas: não há código para vazar
    // ou repassar, e o acesso fica preso a uma pessoa identificada.
    //
    // `list` liberado para quem é da casa, pelo mesmo motivo dos cupons: sem
    // enxergar o que está no ar, não há como apagar autorização órfã. O preço,
    // dito com todas as letras: num futuro com várias empresas, isso exporia os
    // e-mails da equipe de uma para a outra. Hoje a casa é uma só.
    match /acessos/{email} {
      allow get: if request.auth != null
        && (request.auth.token.email.lower() == email
            || ehGestor(resource.data.empresaId));
      allow list: if ehDaCasa();
      allow write: if request.auth != null
        && ehGestor(request.resource.data.empresaId);
      allow delete: if request.auth != null && ehGestor(resource.data.empresaId);
    }

    // Convites: o código (id do doc) é o segredo; só gestor cria
    match /convites/{codigo} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && ehGestor(request.resource.data.empresaId);
      allow delete: if request.auth != null && ehGestor(resource.data.empresaId);
    }

    // Catálogo público: qualquer um lê, membros escrevem
    match /catalogo/{cid} {
      allow read: if true;
      allow write: if ehMembro(cid);
    }

    // Cupom de vendedor. O id do documento É o código.
    //
    // `get` aberto de propósito: o cupom NASCE para ser divulgado, e quem
    // digita o código está justamente provando que o recebeu. Mas `list` é
    // fechado — com listagem liberada, qualquer pessoa baixava a coleção
    // inteira e usava o maior desconto que existisse, sem nunca ter visto o
    // anúncio de vendedor nenhum. É a mesma distinção de `pecas`, `portal`,
    // `rfq` e `vitrines`: ler um documento não é consultar uma coleção.
    //
    // O documento aqui é o RECORTE PÚBLICO: só o que o cliente precisa para ver
    // o desconto na tela. A comissão do vendedor não entra, porque não é da
    // conta de quem compra — ela vive no cadastro da gestão, junto com o resto.
    // Quem escreve é só a casa, e é isso que impede alguém de criar
    // "DESCONTO90" e se auto-conceder comissão.
    // A CASA lista; o público, não. A gestão precisa enxergar o que está no ar
    // para apagar o que já não existe no cadastro dela — sem isso, um cupom
    // apagado lá continuava valendo aqui, dando desconto para sempre. Para
    // quem não é da casa, `list` continua fechado, que é o que impede baixar a
    // coleção inteira e usar o maior desconto que existir.
    match /cupons/{codigo} {
      allow get: if true;
      allow list: if ehDaCasa();
      allow write: if ehDaCasa();
    }

    // Portal do cliente: doc com o MÍNIMO do pedido (item, valor, saldo, etapa).
    // O token no id é o segredo — quem tem o link lê; só membros escrevem.
    match /portal/{token} {
      // Por id, nunca por lista. O token no id é o segredo — e com `list`
      // liberado qualquer um baixava TODOS os portais, isto é, os dados de
      // pedido de todos os clientes, sem login e sem conhecer token nenhum.
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null && ehMembro(request.resource.data.empresaId);
      allow delete: if request.auth != null && ehMembro(resource.data.empresaId);
    }

    // Portal do fornecedor: a cotação é pública (via token) e ele envia a
    // proposta sem login. Escrita anônima é permitida SOMENTE para criar uma
    // resposta, com formato e tamanho limitados — nunca ler as dos outros,
    // nem alterar ou apagar o que já foi enviado.
    match /rfq/{token} {
      // Mesmo caso do portal: o token é o segredo, e listar entregava todas as
      // cotações — com quais fornecedores a casa negocia e o que pediu a eles.
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null && ehMembro(request.resource.data.empresaId);

      match /respostas/{r} {
        allow create: if request.resource.data.keys().hasOnly(['fornecedor','precos','criado'])
          && request.resource.data.fornecedor is string
          && request.resource.data.fornecedor.size() > 0
          && request.resource.data.fornecedor.size() <= 120
          && request.resource.data.precos is map
          && request.resource.data.precos.keys().size() <= 100
          && !get(/databases/$(database)/documents/rfq/$(token)).data.get('fechada', false);
        // só a empresa dona da cotação lê as propostas recebidas
        allow read: if request.auth != null
          && ehMembro(get(/databases/$(database)/documents/rfq/$(token)).data.empresaId);
        allow update, delete: if false;
      }
    }

    // A vitrine pública de uma peça: o que o convidado vê ao encostar.
    //
    // Existe porque o conteúdo "de verdade" mora em `clientes/{uid}/pecas/`, que
    // é privado — o convidado não lê nada de lá, e não deve mesmo. Aqui fica só
    // o recorte que a peça mostra ao mundo.
    //
    // Escreve quem É DONO da peça: a regra confere se existe `pecas/{tagUid}`
    // dentro da conta de quem está escrevendo. Sem isso, qualquer pessoa
    // logada poderia trocar o conteúdo da peça alheia sabendo só o UID do chip
    // — que se lê encostando o celular.
    match /vitrines/{tagUid} {
      // Por id, nunca por lista — o mesmo motivo de `pecas`: com a lista aberta
      // qualquer um enumera os chips existentes e a premissa de que conhecer o
      // UID significa ter tocado na peça deixa de valer.
      allow get: if true;
      allow list: if false;

      // A senha do wi-fi PASSA por aqui, e isso é decisão consciente do dono
      // (jul/2026). A regra anterior a proibia, porque numa página ela vira
      // endereço que se encaminha por mensagem — mas a Apple não implementa o
      // registro `vnd.wfa.wsc`, então SEM a senha na página um convidado de
      // iPhone não consegue conectar de jeito nenhum. Entre proteger a senha e
      // ter o tipo "wi-fi" funcionando em metade dos celulares, o dono escolheu
      // funcionar. É o equivalente ao cartão com a senha ao lado da porta:
      // quem tem o link vê a senha, tenha ou não tocado na peça.
      // FORMATO E TAMANHO LIMITADOS. Sem isto, quem tem uma peça podia gravar
      // um documento de até 1 MB com campos quaisquer, numa coleção de leitura
      // pública — lixo hospedado no domínio da marca, e conta no fim do mês,
      // porque o Blaze não tem teto rígido de gasto.
      // QUEM CHEGOU PRIMEIRO MANDA. Conhecer o UID do chip basta para registrar
      // a peça na própria conta — e conhecer o UID é só ter encostado o celular
      // nela uma vez, numa festa. Sem esta trava, o convidado de ontem
      // reescrevia hoje a página da peça que está na sua sala.
      // Publicar de novo exige ser quem publicou. Ao passar a peça adiante o
      // app apaga a vitrine antes de soltar a peça, e aí o novo dono publica a
      // dele — a passagem continua funcionando.
      // `!('dono' in resource.data)`: vitrines criadas antes desta regra não
      // têm o campo, e não podem ficar impossíveis de atualizar.
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/clientes/$(request.auth.uid)/pecas/$(tagUid))
        && request.resource.data.dono == request.auth.uid
        && (!exists(/databases/$(database)/documents/vitrines/$(tagUid))
            || !('dono' in resource.data)
            || resource.data.dono == request.auth.uid)
        && request.resource.data.keys().hasOnly(['dono','tipo','titulo','dados','senha','itens','atualizadoEm','estilo'])
        // `estilo` é a aparência que o dono escolheu para a página dele: cor de
        // acento, base clara ou escura, e um nome. Tudo texto curto, e nenhum
        // deles é endereço — logo, nada aqui vira link, e o filtro de esquema da
        // página do convidado não precisa se preocupar com este campo.
        //
        // A regra confere CHAVES E TAMANHO, e não formato: validar `#rrggbb`
        // aqui seria repetir no idioma errado o que o painel já faz. O que
        // importa para a casa é que ninguém enfie 1 MB de texto num documento de
        // leitura pública, e isso os tetos garantem.
        && (!('estilo' in request.resource.data) || (
             request.resource.data.estilo is map
             && request.resource.data.estilo.keys().hasOnly(['cor','fundo','marca','logo','logoTam'])
             // `logo` é o endereço da imagem no nosso Storage. O teto de 300 é
             // o bastante para a URL assinada do Firebase e curto o bastante
             // para não virar depósito de texto. Quem confere se o endereço é
             // MESMO nosso é a página do convidado: regra não faz casamento de
             // prefixo de forma confiável, e um `startsWith` aqui daria falsa
             // sensação de trava.
             && request.resource.data.estilo.get('logo','') is string
             && request.resource.data.estilo.get('logo','').size() <= 300
             && request.resource.data.estilo.get('logoTam',0) is number
             && request.resource.data.estilo.get('logoTam',0) >= 0
             && request.resource.data.estilo.get('logoTam',0) <= 200
             && request.resource.data.estilo.get('cor','') is string
             && request.resource.data.estilo.get('cor','').size() <= 7
             && request.resource.data.estilo.get('fundo','') is string
             && request.resource.data.estilo.get('fundo','').size() <= 8
             && request.resource.data.estilo.get('marca','') is string
             && request.resource.data.estilo.get('marca','').size() <= 40
           ))
        // `itens` é a lista do tipo "Meus links". A regra limita a QUANTIDADE;
        // o conteúdo de cada item ela não consegue percorrer — regra não itera
        // lista. O que segura o resto é o teto de 1 MB por documento e o fato
        // de só o dono da peça poder escrever aqui.
        && (!('itens' in request.resource.data)
            || (request.resource.data.itens is list
                && request.resource.data.itens.size() <= 12))
        && request.resource.data.tipo is string
        && request.resource.data.tipo.size() <= 20
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() <= 40
        && request.resource.data.dados is string
        && request.resource.data.dados.size() <= 600
        && (!('senha' in request.resource.data)
            || (request.resource.data.senha is string && request.resource.data.senha.size() <= 80));

      // Apagar também é de quem publicou — senão a trava acima se contornaria
      // apagando a vitrine alheia e publicando outra por cima.
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/clientes/$(request.auth.uid)/pecas/$(tagUid))
        && (!('dono' in resource.data) || resource.data.dono == request.auth.uid);
    }

    // Encomendas feitas pela loja do app.
    //
    // NÃO são pedidos: são PEDIDOS DE COMPRA, esperando a casa aceitar. Sem
    // pagamento (estágio 2), aceitar é decisão humana — confere-se estoque e
    // preço antes de virar pedido de verdade lá na gestão.
    //
    // O preço que vem aqui é o que o cliente VIU, e serve para conferência: a
    // gestão recalcula pelo próprio cadastro na hora de aceitar. Enquanto o
    // servidor não existe, é isso que impede um preço adulterado de virar venda.
    match /encomendas/{id} {
      // O TAMANHO É LIMITADO, e não só o número de itens. Antes, `endereco` e
      // `recado` podiam vir com centenas de milhares de caracteres: qualquer
      // conta engordava a base da casa até o limite de 1 MB por documento, e a
      // conta chegava para o dono.
      allow create: if request.auth != null
        && request.resource.data.clienteUid == request.auth.uid
        && request.resource.data.situacao == 'nova'
        && request.resource.data.keys().hasOnly(['clienteUid','clienteNome','clienteEmail',
             'clienteTelefone','endereco','cep','entrega','recado','itens','totalVisto',
             'situacao','criadaEm','cupom'])
        // O CÓDIGO do cupom, e só. O desconto NÃO vem do cliente: se viesse,
        // alguém mandaria "desconto: 300" e a casa pagaria comissão por cima
        // disso. A gestão lê `cupons/{codigo}` e refaz a conta antes de aceitar,
        // exatamente como já faz com o preço em `totalVisto`.
        && request.resource.data.get('cupom','') is string
        && request.resource.data.get('cupom','').size() <= 24
        && request.resource.data.itens is list
        && request.resource.data.itens.size() > 0
        && request.resource.data.itens.size() <= 30
        && request.resource.data.get('clienteNome','').size() <= 120
        && request.resource.data.get('clienteEmail','').size() <= 160
        && request.resource.data.get('clienteTelefone','').size() <= 20
        && request.resource.data.get('endereco','').size() <= 400
        // O CEP e a FORMA de entrega entram; o VALOR do frete não.
        //
        // É a mesma regra do cupom, e pela mesma razão: se o cliente pudesse
        // mandar `frete: 0`, alguém mandaria. O que sobe daqui é para ONDE e
        // COMO; quem diz quanto custa é a tabela publicada, relida pelo
        // servidor em `criarPagamento`. A lista de chaves acima é o que
        // impede um campo de frete de entrar pela porta dos fundos.
        && request.resource.data.get('cep','').size() <= 9
        && request.resource.data.get('entrega','') in ['', 'correio', 'retirada']
        && request.resource.data.get('recado','').size() <= 500
        && request.resource.data.totalVisto is number
        && request.resource.data.totalVisto >= 0;

      // O cliente lê as próprias (consultando por clienteUid); a casa lê todas.
      allow read: if request.auth != null
        && (ehDaCasa() || resource.data.clienteUid == request.auth.uid);

      // Só a casa muda a situação. O cliente não reescreve o que já mandou.
      allow update: if ehDaCasa();
      allow delete: if false;
    }

    // ==================================================================
    // APP DOS CLIENTES — daqui para baixo é o cinerea-app
    // ==================================================================
    // Cada dono de peça enxerga só o que é dele. Nada aqui cruza com a gestão:
    // um cliente não lê empresa nenhuma, e um gestor não lê as peças de ninguém.

    function ehOCliente(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /clientes/{uid} {
      allow read, write: if ehOCliente(uid);

      // O id da peça é o UID de fábrica da tag NFC — imutável e único por chip.
      // Conteúdo e histórico ficam dentro do documento (histórico é array, não
      // subcoleção), então uma regra só cobre a peça inteira.
      match /pecas/{tagUid} {
        allow read, write: if ehOCliente(uid);
      }

      // Subcoleção nova daqui para frente precisa do próprio bloco: sem match,
      // o Firestore nega. É de propósito — falhar fechado.
    }
  }
}
