rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Conta individual: ponteiro para a empresa + dados legados (pré-migração)
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Empresa: dados compartilhados entre os membros
    match /empresas/{eid} {
      allow create: if request.auth != null && request.resource.data.dono == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/empresas/$(eid)/membros/$(request.auth.uid));

      // Membros: entra quem é o dono (na criação) ou quem apresenta um convite válido
      match /membros/{mUid} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/empresas/$(eid)/membros/$(request.auth.uid));
        allow create: if request.auth != null && request.auth.uid == mUid && (
          get(/databases/$(database)/documents/empresas/$(eid)).data.dono == request.auth.uid
          || (request.resource.data.codigo is string
              && get(/databases/$(database)/documents/convites/$(request.resource.data.codigo)).data.empresaId == eid)
        );
        allow update: if request.auth != null && request.auth.uid == mUid;
        allow delete: if request.auth != null && (request.auth.uid == mUid
          || get(/databases/$(database)/documents/empresas/$(eid)).data.dono == request.auth.uid);
      }

      // Backups mensais automáticos
      match /backups/{b} {
        allow read, write: if request.auth != null
          && exists(/databases/$(database)/documents/empresas/$(eid)/membros/$(request.auth.uid));
      }
    }

    // Convites: o código (id do doc) é o segredo — só quem o recebe consegue ler
    match /convites/{codigo} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/empresas/$(request.resource.data.empresaId)/membros/$(request.auth.uid));
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/empresas/$(resource.data.empresaId)/membros/$(request.auth.uid));
    }

    // Catálogo público: qualquer um lê, só membros da empresa escrevem
    match /catalogo/{cid} {
      allow read: if true;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/empresas/$(cid)/membros/$(request.auth.uid));
    }
  }
}
