rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ATENÇÃO: as regras do Firestore são UM arquivo só para o projeto inteiro
    // (`cinerea1`). Este arquivo é o conjunto completo: o sistema de gestão
    // (usuarios/, empresas/, catalogo/, portal/, rfq/, convites/) MAIS o app dos
    // clientes (clientes/). Publicar só a parte de baixo apagaria a de cima.
    //
    // Este arquivo existe idêntico em dois repositórios:
    //   cinerea-app    → docs/firestore.rules   (é daqui que se publica)
    //   cinerea-gestao → docs/firestore.rules   (espelho, alimenta o CI de lá)
    // Mudou em um, copie no outro — senão os testes de um lado passam a
    // proteger uma regra que não é a que está no ar.

    // ---------- funções de papel ----------
    function ehMembro(eid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/empresas/$(eid)/membros/$(request.auth.uid));
    }
    function ehDono(eid) {
      return request.auth != null
        && get(/databases/$(database)/documents/empresas/$(eid)).data.dono == request.auth.uid;
    }
    function ehGestor(eid) {
      // dono ou admin
      return ehDono(eid) || (ehMembro(eid)
        && get(/databases/$(database)/documents/empresas/$(eid)/membros/$(request.auth.uid)).data.get('papel','') == 'admin');
    }
    function ehFin(eid) {
      // dono, admin ou sócio — quem enxerga o financeiro
      return ehDono(eid) || (ehMembro(eid)
        && get(/databases/$(database)/documents/empresas/$(eid)/membros/$(request.auth.uid)).data.get('papel','') in ['admin','socio']);
    }
    function ehDaCasa() {
      // Quem pode abrir empresa no sistema de gestão. Antes disto, QUALQUER conta
      // autenticada podia — inclusive um cliente do app, que usa o mesmo Auth.
      return request.auth != null
        && exists(/databases/$(database)/documents/gestores/$(request.auth.uid));
    }

    // Lista de quem é da casa. Um documento vazio por uid basta — o que importa
    // é existir. Só se mexe pelo Console do Firebase: nenhum app escreve aqui.
    //
    // Cada um lê APENAS o próprio documento, e só para saber se é da casa — é
    // isso que faz o app dos clientes mostrar a opção de registrar peça na
    // produção para o dono, e escondê-la de todo mundo. Ler o dos outros
    // continua negado, então ninguém descobre quem mais é gestor.
    match /gestores/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Registro de fábrica: uma peça Cinérea que existe no mundo.
    // O id é o UID do chip — o mesmo que identifica a peça no app do cliente.
    //
    // Leitura aberta de propósito: é a certidão da peça, e no futuro a página
    // que o convidado abre ao encostar precisa lê-la sem login. Não há nada
    // pessoal aqui — modelo, número de série e data de fabricação.
    // Escrita só de quem é da casa: é isto que impede um cliente de forjar
    // procedência para uma peça que a Cinérea não fez.
    match /pecas/{tagUid} {
      allow read: if true;
      allow create, update: if ehDaCasa();
      allow delete: if false;
    }

    // Conta individual: ponteiro para a empresa + preferências + dados legados
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Empresa: dados compartilhados
    match /empresas/{eid} {
      allow create: if ehDaCasa() && request.resource.data.dono == request.auth.uid;
      allow read: if ehMembro(eid);
      // qualquer membro salva os DADOS; nome só gestor; o dono nunca muda
      allow update: if ehMembro(eid)
        && request.resource.data.dono == resource.data.dono
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dados','atualizado'])
            || ehGestor(eid));
      allow delete: if ehDono(eid);

      // Membros: papel definido pelo convite; só gestor muda papéis
      match /membros/{mUid} {
        allow read: if ehMembro(eid);
        allow create: if request.auth != null && request.auth.uid == mUid && (
          ehDono(eid)
          || (request.resource.data.codigo is string
              && get(/databases/$(database)/documents/convites/$(request.resource.data.codigo)).data.empresaId == eid
              && request.resource.data.get('papel','empregado')
                 == get(/databases/$(database)/documents/convites/$(request.resource.data.codigo)).data.get('papel','empregado'))
        );
        // cada um só edita o próprio NOME; papel é com o gestor
        allow update: if request.auth != null && (
          (request.auth.uid == mUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome']))
          || ehGestor(eid)
        );
        // sair (não sendo dono) ou gestor remove (menos o dono)
        allow delete: if request.auth != null
          && mUid != get(/databases/$(database)/documents/empresas/$(eid)).data.dono
          && (request.auth.uid == mUid || ehGestor(eid));
      }

      // Financeiro: NEGADO no servidor para empregados
      match /fin/{fdoc} {
        allow read, write: if ehFin(eid);
      }

      // Backups mensais automáticos (contêm o financeiro)
      match /backups/{b} {
        allow read, write: if ehFin(eid);
      }

      // Arquivo de anos anteriores (registros operacionais)
      match /arquivo/{ano} {
        allow read, write: if ehMembro(eid);
      }

      // Diagnóstico: erros de execução capturados pelo app
      match /diag/{d} {
        allow read, write: if ehMembro(eid);
      }
    }

    // Convites: o código (id do doc) é o segredo; só gestor cria
    match /convites/{codigo} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && ehGestor(request.resource.data.empresaId);
      allow delete: if request.auth != null && ehGestor(resource.data.empresaId);
    }

    // Catálogo público: qualquer um lê, membros escrevem
    match /catalogo/{cid} {
      allow read: if true;
      allow write: if ehMembro(cid);
    }

    // Portal do cliente: doc com o MÍNIMO do pedido (item, valor, saldo, etapa).
    // O token no id é o segredo — quem tem o link lê; só membros escrevem.
    match /portal/{token} {
      allow read: if true;
      allow write: if request.auth != null && ehMembro(request.resource.data.empresaId);
      allow delete: if request.auth != null && ehMembro(resource.data.empresaId);
    }

    // Portal do fornecedor: a cotação é pública (via token) e ele envia a
    // proposta sem login. Escrita anônima é permitida SOMENTE para criar uma
    // resposta, com formato e tamanho limitados — nunca ler as dos outros,
    // nem alterar ou apagar o que já foi enviado.
    match /rfq/{token} {
      allow read: if true;
      allow write: if request.auth != null && ehMembro(request.resource.data.empresaId);

      match /respostas/{r} {
        allow create: if request.resource.data.keys().hasOnly(['fornecedor','precos','criado'])
          && request.resource.data.fornecedor is string
          && request.resource.data.fornecedor.size() > 0
          && request.resource.data.fornecedor.size() <= 120
          && request.resource.data.precos is map
          && request.resource.data.precos.keys().size() <= 100
          && !get(/databases/$(database)/documents/rfq/$(token)).data.get('fechada', false);
        // só a empresa dona da cotação lê as propostas recebidas
        allow read: if request.auth != null
          && ehMembro(get(/databases/$(database)/documents/rfq/$(token)).data.empresaId);
        allow update, delete: if false;
      }
    }

    // ==================================================================
    // APP DOS CLIENTES — daqui para baixo é o cinerea-app
    // ==================================================================
    // Cada dono de peça enxerga só o que é dele. Nada aqui cruza com a gestão:
    // um cliente não lê empresa nenhuma, e um gestor não lê as peças de ninguém.

    function ehOCliente(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /clientes/{uid} {
      allow read, write: if ehOCliente(uid);

      // O id da peça é o UID de fábrica da tag NFC — imutável e único por chip.
      // Conteúdo e histórico ficam dentro do documento (histórico é array, não
      // subcoleção), então uma regra só cobre a peça inteira.
      match /pecas/{tagUid} {
        allow read, write: if ehOCliente(uid);
      }

      // Subcoleção nova daqui para frente precisa do próprio bloco: sem match,
      // o Firestore nega. É de propósito — falhar fechado.
    }
  }
}
